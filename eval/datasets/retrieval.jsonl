# eval/datasets/retrieval.jsonl -- C2 retrieval-quality queries (scored by
#   eval/component_eval/retrieval_eval.py), independently labelled with
#   which (grade, page) corpus chunks are actually relevant so Recall@k/
#   MRR can be computed against a live scripts.retrieval call, not a
#   pre-recorded observation.
# Shape: one JSON object per line (JSONL), 49 items, query_id prefix 'rq-'.
# Fields: query_id, query, grade, category, relevant_chunks (list of
#   {grade, page}; empty for out_of_corpus_topic/grade_scope_mismatch
#   categories, which are excluded from Recall@k by design),
#   expected_subject, corpus_coverage_note, observed_result,
#   observed_hit_at_3, observed_rank_of_first_relevant, ambiguity_notes.
{"query_id": "rq-001", "query": "fractions", "grade": 4, "category": "single_word_topic", "relevant_chunks": [{"grade": 4, "page": 101}, {"grade": 4, "page": 102}, {"grade": 4, "page": 103}, {"grade": 4, "page": 104}, {"grade": 4, "page": 107}, {"grade": 4, "page": 109}], "expected_subject": "fractions (NCERT Class 4, 'Jugs and Mugs' chapter)", "corpus_coverage_note": "Relevant chunks confirmed present in data/extracted_json/ncert_chunks.json at grade 4, pages 101-112 (grepped directly for 'numerator|denominator|equal parts|one-half|one-third|one-fourth|quarter of').", "observed_result": "Live retrieve_with_metadata('fractions', 4) returned grade=3 page=88 ('Solve the following...'), grade=3 page=141 (multiplication table), grade=3 page=181 (division worksheet) -- 0 of 3 top results relevant.", "observed_hit_at_3": false, "observed_rank_of_first_relevant": null, "ambiguity_notes": "This is the exact case diagnosed in the live behavioural review: a bare single-word topic query retrieves worksheet chunks from unrelated chapters (multiplication/division), not the fractions chapter. This is the primary evidence motivating the Phase D3/E4 retrieval benchmark."}
