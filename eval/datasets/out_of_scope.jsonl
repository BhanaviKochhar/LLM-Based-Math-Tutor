# eval/datasets/out_of_scope.jsonl -- scope-recognition and honest-refusal
#   items, validated by eval/validate_datasets.py (test_out_of_scope),
#   which independently re-runs scripts.llm.scope.check() against every
#   non-boundary item's question. Deliberately kept separate from
#   arithmetic.jsonl/curriculum_benchmark_class*.jsonl: this tests
#   recognizing a question is OUTSIDE the Class 1-5 curriculum, not
#   in-scope correctness.
# Shape: one JSON object per line (JSONL), 277 items, case_id prefix 'oos-'.
# Fields: case_id, question, truly_out_of_scope, out_of_scope_topic,
#   out_of_scope_reason, boundary_case, boundary_case_note,
#   expected_behavior, must_avoid, live_scope_gate_result (present on
#   genuinely-out-of-scope boundary_case items), notes.
{"case_id": "oos-001", "question": "Solve for x: 2x + 3 = 11.", "out_of_scope_topic": "algebra (linear equations with a variable)", "out_of_scope_reason": "Formal algebraic variables and equation-solving do not appear anywhere in the Class 1-5 topic list (verified_ncert_class_1_5_topics.md); NCERT primary maths uses concrete arithmetic and word problems, not symbolic 'solve for x'.", "boundary_case": true, "boundary_case_note": "Deliberately looks simple (small integers, one step) to test whether the system's scope check is fooled by surface simplicity rather than checking for algebraic form.", "expected_behavior": "Recognize this as outside the Class 1-5 curriculum despite its simplicity, decline to solve it as an algebra problem, and respond honestly (e.g. the existing fixed refusal) rather than silently treating 'x' as a number to guess or presenting a step-by-step algebraic solution as if it were curriculum-aligned.", "must_avoid": ["Presenting isolate-the-variable steps as a normal worked solution.", "Silently substituting a guessed value for x without flagging that this is algebra.", "Treating the small numbers involved as evidence this is primary-level content."], "notes": "Expected behavior is stated at a high level per the Phase B task scope; this is not yet scored against the live system in this pass.", "truly_out_of_scope": true, "live_scope_gate_result": {"in_scope": false, "topic": "algebra", "allow_gloss": false}}
