# eval/datasets/conceptual.jsonl -- pedagogical/behavioural judgment cases
#   for scoring the tutor's CONVERSATIONAL response quality (disposition,
#   scaffolding, acknowledgement of student reasoning), not a numeric
#   answer. Validated structurally by eval/validate_datasets.py; scored
#   by human/LLM rubric against rubric_dimensions_most_relevant, not by
#   any component_eval/*.py module today.
# Shape: one JSON object per line (JSONL), 23 items, case_id prefix 'co-'.
# Fields: case_id, scenario, prior_context, student_input,
#   student_likely_understanding, mathematically_correct_or_incorrect,
#   what_tutor_response_should_accomplish, disposition, essential_elements,
#   must_avoid, rubric_dimensions_most_relevant, observed_system_behaviour,
#   notes (present on some items).
{"case_id": "co-001", "scenario": "equivalent_fraction_vs_quantity_confusion", "prior_context": ["Tutor asked: write a fraction for one-third of nine toffees."], "student_input": "3/9", "student_likely_understanding": "The student correctly simplifies/relates 3/9 to the proportion one-third (3/9 = 1/3 is mathematically valid), but the tutor's question asked for a QUANTITY (how many toffees), not a proportion -- the expected quantity answer was 3, not a fraction at all.", "mathematically_correct_or_incorrect": "3/9 is a mathematically VALID simplification of 1/3, so it is not simply 'wrong' -- but it does not answer the quantity question asked ('how many toffees').", "what_tutor_response_should_accomplish": "Acknowledge that 3/9 correctly equals 1/3 (do not mark it wrong), then clarify the distinction between the proportion (1/3) and the quantity being asked for (3 toffees), and ask the student to state the quantity.", "disposition": "acknowledge_and_clarify", "essential_elements": ["Explicitly state that 3/9 = 1/3 is correct as a fraction.", "Explicitly distinguish 'the fraction of the whole' from 'the number of toffees'.", "Ask for or lead toward the quantity answer (3), without just stating it outright if the episode design calls for one more attempt first."], "must_avoid": ["Treating 3/9 as simply wrong.", "Ignoring the specific value '3/9' and giving a generic unrelated fraction explanation.", "Introducing a new unrelated example instead of resolving this one."], "rubric_dimensions_most_relevant": ["mathematical_correctness", "relevance_to_latest_input", "recognition_of_demonstrated_reasoning"], "observed_system_behaviour": "The live system (both before and after the _d_ack_conceptual directive change made in this review) responded with a generic restatement of fraction simplification rules and pivoted to a different, unrelated example, without directly resolving the proportion-vs-quantity distinction. See docs/development_test_log.md for the full transcript and the A/B comparison across directive wordings. This is an open, UNRESOLVED gap, not validated as fixed."}
{"case_id": "co-002", "scenario": "correct_concrete_reasoning_in_own_words", "prior_context": ["Episode started from the bare topic word 'fractions' (no specific problem)."], "student_input": "I have one mango, cut in 2 pieces. I have both pieces.", "student_likely_understanding": "The student is reasoning concretely that 2 pieces out of 2 equal pieces makes a whole mango (2/2 = 1) -- correct, specific, self-generated reasoning, not a copied definition.", "mathematically_correct_or_incorrect": "Correct: 2/2 = 1, i.e. 'both pieces' of something cut into 2 equal pieces is the whole.", "what_tutor_response_should_accomplish": "Recognise that the student has just described 2/2 and should confirm that having both halves makes one whole mango, naming the fraction 2/2 explicitly and tying it back to the number the student actually used (2 pieces).", "disposition": "acknowledge_and_confirm", "essential_elements": ["Reference 'both pieces' / '2 pieces' specifically, not a generic mango/chocolate example invented by the tutor.", "State or lead the student to state that 2 out of 2 equal pieces = 1 whole / 2/2 = 1.", "Keep the mango framing the student introduced rather than switching to a new object (cake, chocolate, toffees)."], "must_avoid": ["Giving a disconnected generic definition of a fraction.", "Switching to a brand-new example (e.g. a different food item or a different split) instead of using the student's own mango.", "Referencing an unrelated earlier turn's content (e.g. the word 'fractions' from turn 1) as if it were the student's current message."], "rubric_dimensions_most_relevant": ["recognition_of_demonstrated_reasoning", "relevance_to_latest_input", "context_preservation"], "observed_system_behaviour": "The live system ignored the mango-specific reasoning entirely and gave a disconnected generic fraction explanation (observed with the original directive) or, with the reworded directive, referenced the WRONG earlier turn's content ('Nice, you've written fractions') -- a context-preservation failure distinct from the acknowledgement gap. See docs/development_test_log.md Case A/C A-B comparison."}
{"case_id": "co-003", "scenario": "broad_topic_initiation", "prior_context": [], "student_input": "fractions", "student_likely_understanding": "The student wants to learn about or review fractions generally; this is a topic request, not a specific problem.", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "Open with a concrete, correctly-grounded example (ideally retrieved from the actual fractions chapter, not an unrelated worksheet) and invite the student toward a SPECIFIC, answerable first question, rather than leaving the episode permanently ungradable.", "disposition": "scaffold_toward_specific_question", "essential_elements": ["Grounding example should be mathematically about fractions (not multiplication/division content misretrieved for a generic query).", "Should move toward a concrete, specific, ideally computable first exercise."], "must_avoid": ["Retrieving and explaining content from an unrelated chapter (e.g. multiplication tables) under the fractions topic.", "Staying abstract/ungradable indefinitely across many turns with no path to a concrete exercise."], "rubric_dimensions_most_relevant": ["mathematical_correctness", "appropriate_progression"], "observed_system_behaviour": "Retrieval for the bare word 'fractions' returns unrelated multiplication/division worksheet chunks (see eval/datasets/retrieval.jsonl rq-001), and the resulting episode has is_math=False/computed_answer=None for its entire duration, so controller.diagnose() can only ever return 'engaged' (ACK_CONCEPTUAL) -- see eval/datasets/controller_scenarios.json ctl-012. The episode has no built-in mechanism to progress toward a specific, gradable exercise."}
{"case_id": "co-004", "scenario": "partial_understanding", "prior_context": ["Tutor explained that a fraction shows how many equal parts of a whole you have."], "student_input": "so the bottom number is how many pieces there are", "student_likely_understanding": "Partially correct: the student has correctly identified the role of the denominator but has not yet mentioned the numerator's role.", "mathematically_correct_or_incorrect": "Correct as far as it goes; incomplete.", "what_tutor_response_should_accomplish": "Confirm the correct part specifically (the denominator point), then add the missing piece (what the numerator means), building directly on what was just said rather than restating the whole definition from scratch.", "disposition": "confirm_and_extend", "essential_elements": ["Explicit confirmation that the denominator point is correct.", "Addition of the numerator's meaning as the next, connected idea."], "must_avoid": ["Re-explaining the denominator point as if it hadn't been understood.", "Jumping to an unrelated new example instead of extending the current one."], "rubric_dimensions_most_relevant": ["recognition_of_demonstrated_reasoning", "appropriate_scaffolding"], "observed_system_behaviour": "not observed live; written to probe partial-credit recognition, a capability not exercised by the single observed conversation."}
{"case_id": "co-005", "scenario": "incorrect_concept", "prior_context": ["Tutor explained fractions as equal parts of a whole."], "student_input": "so if I cut it into more pieces each piece gets bigger", "student_likely_understanding": "Incorrect: the student has the inverse relationship backwards -- more equal pieces means each piece is SMALLER, not bigger.", "mathematically_correct_or_incorrect": "Incorrect.", "what_tutor_response_should_accomplish": "Gently correct the specific misconception (more pieces -> smaller pieces) using a concrete comparison (e.g. cutting into 2 vs 4 pieces), without being dismissive.", "disposition": "correct_specifically", "essential_elements": ["Directly address the inverse-relationship error.", "Use a concrete comparison to make the correction tangible."], "must_avoid": ["Agreeing with or failing to flag the incorrect claim.", "A generic, unrelated fraction definition that doesn't engage with the specific misconception stated."], "rubric_dimensions_most_relevant": ["mathematical_correctness", "recognition_of_demonstrated_reasoning"], "observed_system_behaviour": "not observed live; written to probe misconception correction, which the single observed conversation did not happen to contain."}
{"case_id": "co-006", "scenario": "numeric_answer_where_fraction_requested", "prior_context": ["Tutor asked: what fraction of the 8 mangoes is 2 mangoes?"], "student_input": "2", "student_likely_understanding": "The student has stated the numerator's value (or possibly just repeated a number from the question) but has not expressed it as a fraction of the whole.", "mathematically_correct_or_incorrect": "Incomplete/ambiguous -- '2' alone could mean 'the numerator is 2' (on the way to 2/8=1/4) or could be an unrelated guess.", "what_tutor_response_should_accomplish": "Ask the student to relate the 2 to the whole (how many total, so what fraction), rather than silently guessing which interpretation is intended.", "disposition": "clarify_ambiguous_form", "essential_elements": ["Recognise the answer is not yet in fraction form.", "Prompt specifically for the fraction form (numerator over denominator)."], "must_avoid": ["Silently accepting '2' as a correct final answer to a fraction question.", "Silently marking it wrong without asking what the student meant."], "rubric_dimensions_most_relevant": ["mathematical_correctness", "appropriate_scaffolding"], "observed_system_behaviour": "not observed live; written to probe the ASK_ANSWER-style ambiguous-form handling in a conceptual (non-numeric-only) context."}
{"case_id": "co-007", "scenario": "hint_request_on_conceptual_question", "prior_context": ["Episode is conceptual (is_math=False); tutor has given one explanation already."], "student_input": "Give me a hint", "student_likely_understanding": "not_applicable (requesting help, not demonstrating understanding)", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "A hint implies there is a specific question to be hinted toward; for a conceptual episode with no concrete exercise yet, the tutor should either hint toward a concrete next step the student could try, or acknowledge there isn't yet a specific problem to hint at.", "disposition": "scaffold_toward_specific_question", "essential_elements": ["Should not fabricate a hint for a problem that was never posed."], "must_avoid": ["Giving a hint that presupposes a specific numeric problem the controller never actually set up."], "rubric_dimensions_most_relevant": ["appropriate_scaffolding", "clarity_and_age_appropriateness"], "observed_system_behaviour": "not independently re-verified in this review; flagged as a plausible gap given that pipeline.generate_turn's HINT branch calls get_hint() unconditionally regardless of whether state.is_math is True."}
{"case_id": "co-008", "scenario": "worked_example_request", "prior_context": ["Student has been given one conceptual explanation of fractions."], "student_input": "Show me how", "student_likely_understanding": "not_applicable (requesting a worked example)", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "Since there is no specific computable problem in this episode, 'show me how' cannot produce a worked solution with a final numeric answer; the tutor should work a concrete EXAMPLE problem end-to-end (not another abstract explanation) so the student sees a full worked case.", "disposition": "scaffold_toward_specific_question", "essential_elements": ["Should produce one concrete, complete worked example (not another abstract paragraph)."], "must_avoid": ["Giving yet another abstract conceptual explanation in response to an explicit request to 'see it worked out'."], "rubric_dimensions_most_relevant": ["avoidance_of_unnecessary_repetition", "appropriate_progression"], "observed_system_behaviour": "The live system's response to 'Show me how' in the reviewed conversation was another broad conceptual explanation, not a worked example -- consistent with MODE_ACK_CONCEPTUAL being the only available action for a conceptual episode regardless of the SOLVE-like intent of the words used (the SOLVE intent only has special handling in controller.py when is_math=True)."}
{"case_id": "co-009", "scenario": "topic_change_mid_conceptual_episode", "prior_context": ["Ongoing conceptual episode about fractions."], "student_input": "what is 9 times 7", "student_likely_understanding": "not_applicable (new, unrelated, computable question)", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "Recognise this as a genuinely new, computable question and start a fresh (gradable) episode for it, rather than treating it as another conceptual follow-up about fractions.", "disposition": "start_new_episode", "essential_elements": ["intent/conversation resolution should classify this as NEW_QUESTION / a new topic, not as a conceptual follow-up.", "The new episode should have is_math=True, computed_answer=63."], "must_avoid": ["Treating '9 times 7' as a continuation of the fractions discussion.", "Failing to compute/inject a trusted answer for the new, clearly computable question."], "rubric_dimensions_most_relevant": ["context_preservation", "appropriate_progression"], "observed_system_behaviour": "This specific transition (computable new question arriving mid-CONCEPTUAL-episode) was not part of the observed conversation; the mid-episode new-question smoke test used a MATH episode, not a conceptual one, so the conceptual-episode variant has not been observed live."}
{"case_id": "co-010", "scenario": "discrepancy_diagnosis_request", "prior_context": ["Tutor asked: What is 18 + 14?"], "student_input": "I got 27 but the book says 32. Where did I go wrong?", "student_likely_understanding": "The student has a wrong intermediate result and is explicitly asking for the specific error, not just the correct answer.", "mathematically_correct_or_incorrect": "Incorrect", "what_tutor_response_should_accomplish": "Diagnose the LIKELY specific slip (e.g. forgetting to carry the regrouped ten from the ones column into the tens column: 8+4=12, write 2 carry 1, then 1+1+1=3, giving 32) rather than just restating that the answer is 32.", "disposition": "correct_specifically", "essential_elements": ["Walk through the carrying step explicitly using the student's own numbers (18+14)", "Point to the specific point of divergence between 27 and 32, not a generic re-explanation of addition"], "must_avoid": ["Just stating '32 is correct' without diagnosing where 27 came from", "Assuming the textbook/book is wrong instead of checking the student's work"], "rubric_dimensions_most_relevant": ["mathematical_correctness", "recognition_of_demonstrated_reasoning", "appropriate_scaffolding"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-011", "scenario": "correct_answer_without_understanding", "prior_context": ["Tutor asked: What is 4 x 6?"], "student_input": "I know the answer is 24, but I don't understand why.", "student_likely_understanding": "The student has memorized or guessed the correct numeric result but lacks the underlying concept of what multiplication represents.", "mathematically_correct_or_incorrect": "Correct", "what_tutor_response_should_accomplish": "Build genuine understanding of WHY 4x6=24 (e.g. 6 groups of 4, or repeated addition 4+4+4+4+4+4=24) rather than simply re-confirming the already-correct number.", "disposition": "confirm_and_extend", "essential_elements": ["Explain the multiplication as equal groups or repeated addition, connecting to the specific numbers 4 and 6", "Do not just repeat '24 is correct' without adding the explanation the student explicitly asked for"], "must_avoid": ["Treating this as a graded attempt that needs no further response since the number is right", "Giving an explanation for different numbers instead of 4 and 6"], "rubric_dimensions_most_relevant": ["recognition_of_demonstrated_reasoning", "clarity_and_age_appropriateness", "appropriate_scaffolding"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-012", "scenario": "method_comparison_request", "prior_context": ["Tutor showed subtraction with borrowing for 52 - 27.", "Tutor also mentioned counting up on a number line as an alternative."], "student_input": "Which method is easier and why -- the borrowing one or counting up on a number line?", "student_likely_understanding": "not_applicable", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "Give a genuine, specific comparison of the two methods for THIS problem (e.g. counting up from 27 to 52 may be easier when the gap is small; borrowing is more systematic for larger multi-digit problems) rather than a non-answer or a one-sided dismissal of either method.", "disposition": "confirm_and_extend", "essential_elements": ["Name a concrete trade-off between the two methods, tied to the actual numbers in this problem", "Avoid declaring one method universally 'better' without qualification"], "must_avoid": ["Refusing to compare ('both are fine') without any specific reasoning", "Introducing a third, unrequested method instead of comparing the two asked about"], "rubric_dimensions_most_relevant": ["relevance_to_latest_input", "clarity_and_age_appropriateness"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-013", "scenario": "fraction_comparison_with_explanation_request", "prior_context": [], "student_input": "Is 1/2 bigger than 1/3? Explain.", "student_likely_understanding": "not_applicable -- this is a direct question, not a demonstration of the student's own reasoning.", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "Confirm that 1/2 > 1/3 and explain WHY using a concrete model (e.g. splitting the same whole into 2 vs 3 equal pieces -- fewer, bigger pieces vs more, smaller pieces), not just assert the inequality.", "disposition": "confirm_and_extend", "essential_elements": ["State clearly that 1/2 is bigger than 1/3", "Explain using a same-whole-numerator-1 model why fewer equal parts means each part is bigger"], "must_avoid": ["Answering only 'yes' or 'no' without the requested explanation"], "rubric_dimensions_most_relevant": ["mathematical_correctness", "clarity_and_age_appropriateness"], "observed_system_behaviour": "not observed live", "notes": "This exact prompt is one of the task's own listed examples; kept as a single item despite fractions already being the most densely covered topic elsewhere in this project -- not expanded further for that reason."}
{"case_id": "co-014", "scenario": "misconception_borrowing_overcorrection", "prior_context": ["Tutor explained regrouping/borrowing in subtraction."], "student_input": "I make the smaller top digit bigger by adding 10, but I forget to also reduce the digit I borrowed FROM, so my final answer feels too big.", "student_likely_understanding": "Partially correct: the student understands the 'add 10 to the smaller digit' half of borrowing but has identified (self-diagnosed) that they are not completing the second half of the operation.", "mathematically_correct_or_incorrect": "Incomplete/ambiguous", "what_tutor_response_should_accomplish": "Confirm the first half is right, then specifically complete the missing half: after adding 10 to the ones digit, the TENS digit being borrowed from must be reduced by 1 before continuing.", "disposition": "confirm_and_extend", "essential_elements": ["Acknowledge the correct half of the student's own description", "Add the missing second half (reduce the lending column by 1) using the same borrowing framing the student used"], "must_avoid": ["Re-explaining borrowing from scratch as if the student understood nothing", "Ignoring that the student has already self-diagnosed part of the problem"], "rubric_dimensions_most_relevant": ["recognition_of_demonstrated_reasoning", "appropriate_scaffolding"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-015", "scenario": "misconception_place_value_digit_confusion", "prior_context": [], "student_input": "I think the 3 in 435 and the 3 in 357 mean the same thing, since it's the same digit.", "student_likely_understanding": "Incorrect: the student is ignoring place value and treating a digit's meaning as fixed regardless of its position.", "mathematically_correct_or_incorrect": "Incorrect", "what_tutor_response_should_accomplish": "Correct the specific misconception using the student's own two numbers: in 435 the 3 is in the hundreds place (worth 300); in 357 the 3 is in the ones place (worth 3).", "disposition": "correct_specifically", "essential_elements": ["Use the student's own two example numbers (435 and 357), not a new pair", "State the specific place-value difference (hundreds vs ones) and the resulting values (300 vs 3)"], "must_avoid": ["A generic place-value lecture that never returns to the specific numbers 435 and 357"], "rubric_dimensions_most_relevant": ["mathematical_correctness", "recognition_of_demonstrated_reasoning"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-016", "scenario": "broad_explanation_request", "prior_context": [], "student_input": "Can you explain borrowing/carrying to me?", "student_likely_understanding": "not_applicable -- a broad topic request, not a demonstration of existing understanding.", "mathematically_correct_or_incorrect": "not_applicable", "what_tutor_response_should_accomplish": "Give a concrete, grounded explanation (ideally with one worked example using specific numbers), then move toward a specific, gradable practice question rather than staying abstract indefinitely.", "disposition": "scaffold_toward_specific_question", "essential_elements": ["Use at least one concrete numeric example while explaining", "End by inviting a specific practice attempt"], "must_avoid": ["Staying entirely abstract with no worked example", "Looping on the same generic explanation across multiple turns if the student asks again (see the related, already-tracked conceptual-tutoring progression issue for 'fractions' episodes)"], "rubric_dimensions_most_relevant": ["clarity_and_age_appropriateness", "appropriate_progression"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-017", "scenario": "partially_correct_division_answer", "prior_context": ["Tutor asked: Share 23 pencils equally among 5 students. How many does each get?"], "student_input": "4 each.", "student_likely_understanding": "Correct on the quotient but silent on the remainder; it is ambiguous whether the student has forgotten the remainder exists or considers the question fully answered by the quotient alone.", "mathematically_correct_or_incorrect": "Incomplete/ambiguous", "what_tutor_response_should_accomplish": "Confirm the quotient (4) is right, then explicitly ask about or state the remainder (3 pencils left over) rather than treating the answer as fully complete or as fully wrong.", "disposition": "confirm_and_extend", "essential_elements": ["Confirm '4 each' is correct as far as it goes", "Prompt for or supply the remainder (3) rather than silently accepting an incomplete answer as the full solution"], "must_avoid": ["Marking the answer fully wrong because the remainder was omitted", "Silently accepting '4' as the complete final answer with no mention of the remainder"], "rubric_dimensions_most_relevant": ["mathematical_correctness", "appropriate_scaffolding"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-018", "scenario": "misconception_angle_approximation", "prior_context": ["Tutor asked: Classify a 95-degree angle as acute, right, or obtuse."], "student_input": "I think it's a right angle because it's close to 90.", "student_likely_understanding": "Incorrect: the student is treating 'close to 90' as equivalent to 'exactly 90', when a right angle requires exactly 90 degrees.", "mathematically_correct_or_incorrect": "Incorrect", "what_tutor_response_should_accomplish": "Correct the specific misconception: a right angle must be EXACTLY 90 degrees; 95 degrees, being more than 90, is obtuse, even though it is numerically close.", "disposition": "correct_specifically", "essential_elements": ["State explicitly that 'close to 90' is not the same as 'equal to 90'", "Give the correct classification (obtuse) with the reason (more than 90 degrees)"], "must_avoid": ["Agreeing that 95 is 'basically' a right angle", "A generic angle-types lecture that never addresses the specific 'closeness' reasoning the student used"], "rubric_dimensions_most_relevant": ["mathematical_correctness", "recognition_of_demonstrated_reasoning"], "observed_system_behaviour": "not observed live"}
{"case_id": "co-019", "scenario": "misconception_factors_vs_multiples_confusion", "prior_context": ["Tutor asked: List the factors of 12."], "student_input": "1, 2, 3, 4, 6, 12, 24 -- I included 24 too because it's a multiple of 12.", "student_likely_understanding": "The student correctly lists the actual factors (1,2,3,4,6,12) but incorrectly appends 24, apparently conflating 'factor' and 'multiple' at the boundary.", "mathematically_correct_or_incorrect": "Incomplete/ambiguous", "what_tutor_response_should_accomplish": "Confirm the correct factors the student listed, then specifically explain why 24 does not belong (it's a MULTIPLE of 12, not a factor -- factors divide INTO 12, multiples are 12 multiplied up).", "disposition": "correct_specifically", "essential_elements": ["Confirm the six genuine factors are correct", "Explain specifically why 24 is a multiple, not a factor, directly addressing the student's own stated reasoning"], "must_avoid": ["Marking the whole list wrong without crediting the five correct factors", "A generic factors-vs-multiples definition that doesn't return to the number 24 the student actually proposed"], "rubric_dimensions_most_relevant": ["mathematical_correctness", "recognition_of_demonstrated_reasoning"], "observed_system_behaviour": "not observed live"}
