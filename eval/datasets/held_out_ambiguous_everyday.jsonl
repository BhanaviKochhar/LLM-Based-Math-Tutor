# eval/datasets/held_out_ambiguous_everyday.jsonl -- fresh held-out items
#   for two tutor-prompt changes: answering ordinary questions the textbook
#   context doesn't cover (instead of "Let's ask your teacher"), and naming
#   every valid answer when a question has more than one. Written 2026-10-23
#   AFTER the fixes were agreed and BEFORE any v2 run, none copied from
#   another dataset; frozen from then on. Never used to tune anything.
# Shape: one JSON object per line, 20 items, case_id prefix 'ho-ae-'.
# Fields: case_id, grade, kind (ambiguous | everyday), question,
#   valid_answers (every acceptable answer, or a rule for them),
#   expected_behavior, must_avoid.
{"case_id": "ho-ae-01", "grade": 1, "kind": "ambiguous", "question": "Show me how to make 8 by adding two numbers.", "valid_answers": ["0 + 8", "1 + 7", "2 + 6", "3 + 5", "4 + 4", "and the same pairs swapped"], "expected_behavior": "Say there are several ways and give more than one pair that adds to 8.", "must_avoid": ["Presenting one pair as the only way to make 8."]}
{"case_id": "ho-ae-02", "grade": 2, "kind": "ambiguous", "question": "What comes next in this pattern: 2, 4, ...?", "valid_answers": ["6 (adding 2 each time)", "8 (doubling each time)"], "expected_behavior": "Say that with only two numbers the rule isn't fixed, and give at least two possible next numbers with their rules (6 by adding 2, 8 by doubling).", "must_avoid": ["Giving one next number as the only possible answer."]}
{"case_id": "ho-ae-03", "grade": 3, "kind": "ambiguous", "question": "I have 12 sweets and want to put them in equal rows. How many rows can I make?", "valid_answers": ["1", "2", "3", "4", "6", "12"], "expected_behavior": "Say that several arrangements work and list the possible numbers of rows (1, 2, 3, 4, 6 or 12), or at least several of them.", "must_avoid": ["Giving a single number of rows as the only answer."]}
{"case_id": "ho-ae-04", "grade": 4, "kind": "ambiguous", "question": "I paid exactly Rs. 50 using only Rs. 10 and Rs. 20 notes. Which notes could I have used?", "valid_answers": ["five Rs. 10 notes", "three Rs. 10 notes and one Rs. 20 note", "one Rs. 10 note and two Rs. 20 notes"], "expected_behavior": "Say there is more than one way and give at least two of the three possible combinations.", "must_avoid": ["Presenting one combination as the only answer.", "Giving a combination that does not add to Rs. 50."]}
{"case_id": "ho-ae-05", "grade": 2, "kind": "ambiguous", "question": "Which coins could I use to make Rs. 7?", "valid_answers": ["any combination of Rs. 1, 2 and 5 coins adding to 7, e.g. 5 + 2, 5 + 1 + 1, 2 + 2 + 2 + 1"], "expected_behavior": "Say there are several ways and give at least two different coin combinations that add to Rs. 7.", "must_avoid": ["Giving one combination as the only way."]}
{"case_id": "ho-ae-06", "grade": 5, "kind": "ambiguous", "question": "Name a number that is a multiple of both 2 and 3.", "valid_answers": ["any multiple of 6, e.g. 6, 12, 18, 24"], "expected_behavior": "Give a valid number and make clear there are many (any multiple of 6), e.g. by naming more than one.", "must_avoid": ["Implying 6 (or any single number) is the only answer."]}
{"case_id": "ho-ae-07", "grade": 3, "kind": "ambiguous", "question": "A number rounded to the nearest ten is 40. What could the number be?", "valid_answers": ["any whole number from 35 to 44"], "expected_behavior": "Say several numbers work and give the range 35 to 44 (or several examples from it).", "must_avoid": ["Giving one number as the only answer.", "Including 45 or 34 as valid."]}
{"case_id": "ho-ae-08", "grade": 1, "kind": "ambiguous", "question": "I am thinking of a shape with 4 corners. What shape could it be?", "valid_answers": ["square", "rectangle", "any four-sided shape"], "expected_behavior": "Say more than one shape is possible and name at least two (square, rectangle).", "must_avoid": ["Naming one shape as the only possible answer."]}
{"case_id": "ho-ae-09", "grade": 4, "kind": "ambiguous", "question": "Write a fraction that is equal to 3/4.", "valid_answers": ["6/8", "9/12", "12/16", "any 3n/4n"], "expected_behavior": "Give an equivalent fraction and make clear there are many (e.g. 6/8, 9/12), by naming more than one or stating the rule.", "must_avoid": ["Implying one equivalent fraction is the only answer."]}
{"case_id": "ho-ae-10", "grade": 5, "kind": "ambiguous", "question": "Which two numbers multiply to make 24?", "valid_answers": ["1 and 24", "2 and 12", "3 and 8", "4 and 6"], "expected_behavior": "Say there are several pairs and give more than one (1 x 24, 2 x 12, 3 x 8, 4 x 6).", "must_avoid": ["Giving one pair as the only answer."]}
{"case_id": "ho-ae-11", "grade": 1, "kind": "everyday", "question": "Name something in your classroom that is shaped like a rectangle.", "valid_answers": ["a door, the blackboard, a book, a desk top, a window, or any rectangular object"], "expected_behavior": "Answer with one or more sensible rectangular classroom objects.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-12", "grade": 1, "kind": "everyday", "question": "What do we give the shopkeeper when we buy something?", "valid_answers": ["money (coins or notes)"], "expected_behavior": "Answer simply that we pay with money: coins or notes.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-13", "grade": 2, "kind": "everyday", "question": "Name a fruit that is round.", "valid_answers": ["an orange, an apple, a watermelon, a grape, a lemon, or any roughly round fruit"], "expected_behavior": "Answer with one or more round fruits.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-14", "grade": 2, "kind": "everyday", "question": "What could you use at home to find out which of two toys is heavier?", "valid_answers": ["holding one in each hand, a weighing scale or balance, a simple hanger balance"], "expected_behavior": "Suggest a sensible everyday way to compare weights (hold them, or use a balance/scale).", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-15", "grade": 3, "kind": "everyday", "question": "What could you use to measure how long your pencil is?", "valid_answers": ["a ruler or scale", "a measuring tape", "a non-standard unit like a paper clip"], "expected_behavior": "Name a sensible measuring tool, such as a ruler.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-16", "grade": 3, "kind": "everyday", "question": "Name something at home that is usually bought by the dozen.", "valid_answers": ["eggs", "bananas", "bangles", "pencils", "any item commonly sold in twelves"], "expected_behavior": "Name something commonly sold by the dozen, ideally saying a dozen is 12.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-17", "grade": 4, "kind": "everyday", "question": "Name something at home that holds about 1 litre.", "valid_answers": ["a water bottle", "a milk packet", "a jug", "an oil bottle"], "expected_behavior": "Name a sensible container of about 1 litre.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-18", "grade": 4, "kind": "everyday", "question": "Which would you measure in kilometres: the length of your room or the distance to another city?", "valid_answers": ["the distance to another city"], "expected_behavior": "Choose the distance to another city and say why (kilometres are for long distances).", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-19", "grade": 5, "kind": "everyday", "question": "Where in your house might you find a right angle?", "valid_answers": ["the corner of a door, book, table top, window, tile, or wall"], "expected_behavior": "Name one or more everyday right-angle corners.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
{"case_id": "ho-ae-20", "grade": 5, "kind": "everyday", "question": "Name something in your home that turns in a full circle, like a wheel.", "valid_answers": ["a ceiling fan", "clock hands", "a tap handle", "a mixer blade", "a doorknob"], "expected_behavior": "Name one or more things that rotate all the way round.", "must_avoid": ["Refusing or replying 'Let's ask your teacher about this one!'."]}
